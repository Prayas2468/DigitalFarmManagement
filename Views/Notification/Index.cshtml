@model List<Notification>
@{
    ViewData["Title"] = "Notifications";
    var category = ViewBag.Category as string;
}
<div class="page-head">
    <div>
        <h1>Notifications</h1>
        <p>Alerts are rebuilt from the database: residue violations, withdrawal holds, stock, and follow-ups.</p>
    </div>
    <form asp-action="MarkAll" method="post">
        <button class="btn btn-light" type="submit">Mark all as read</button>
    </form>
</div>
<form method="get" class="filter-bar">
    <select class="form-select" name="category">
        <option value="">All categories</option>
        @foreach (var item in AlertCategories.All)
        {
            if (item == category) { <option value="@item" selected>@item</option> }
            else { <option value="@item">@item</option> }
        }
    </select>
    <button class="btn btn-outline-secondary" type="submit">Filter</button>
</form>
<div class="panel">
    @if (Model.Count == 0)
    {
        <div class="empty">No alerts in this category.</div>
    }
    <div class="alert-stack">
        @foreach (var note in Model)
        {
            var tone = note.Severity switch
            {
                "Danger" => "danger",
                "Warning" => "warning",
                _ => ""
            };
            <a class="mini-alert @tone text-decoration-none text-dark @(note.IsRead ? "opacity-75" : "")" asp-action="Open" asp-route-id="@note.Id">
                <div class="d-flex justify-content-between gap-3">
                    <strong>@note.Title</strong>
                    <span class="small text-muted">@Ui.Ago(note.CreatedAt)</span>
                </div>
                <div>@note.Message</div>
                <div class="small text-muted mt-1">@note.Category@(note.IsRead ? " · read" : " · unread")</div>
            </a>
        }
    </div>
</div>
