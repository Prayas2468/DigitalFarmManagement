@model FarmFormViewModel
@{
    ViewData["Title"] = Model.Id == 0 ? "Add farm" : "Edit farm";
}
<div class="page-head"><div><h1>@ViewData["Title"]</h1><p>Farm ID is assigned by the database when you save.</p></div></div>
<form asp-action="@(Model.Id == 0 ? "Create" : "Edit")" method="post" class="panel">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="hidden" asp-for="Id" />
    <div class="row g-3">
        <div class="col-md-6"><label asp-for="FarmName" class="form-label"></label><input asp-for="FarmName" class="form-control" /><span asp-validation-for="FarmName" class="text-danger small"></span></div>
        <div class="col-md-6"><label asp-for="FarmerName" class="form-label"></label><input asp-for="FarmerName" class="form-control" /><span asp-validation-for="FarmerName" class="text-danger small"></span></div>
        <div class="col-md-6">
            <label asp-for="Location" class="form-label"></label>
            <input asp-for="Location" class="form-control" list="locations" />
            <datalist id="locations">
                @foreach (var location in Model.KnownLocations) { <option value="@location"></option> }
            </datalist>
            <span asp-validation-for="Location" class="text-danger small"></span>
        </div>
        <div class="col-md-6"><label asp-for="ContactNumber" class="form-label"></label><input asp-for="ContactNumber" class="form-control" /><span asp-validation-for="ContactNumber" class="text-danger small"></span></div>
        <div class="col-md-6"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" /><span asp-validation-for="Email" class="text-danger small"></span></div>
        <div class="col-md-3">
            <label asp-for="FarmType" class="form-label"></label>
            <select asp-for="FarmType" class="form-select">
                <option value="">Choose</option>
                @foreach (var type in FarmTypes.All) { <option value="@type">@type</option> }
            </select>
            <span asp-validation-for="FarmType" class="text-danger small"></span>
        </div>
        <div class="col-md-3"><label asp-for="RegistrationDate" class="form-label"></label><input asp-for="RegistrationDate" class="form-control" type="date" /><span asp-validation-for="RegistrationDate" class="text-danger small"></span></div>
        @if (Model.CanAssignOwner)
        {
            <div class="col-md-6">
                <label asp-for="OwnerId" class="form-label"></label>
                <select asp-for="OwnerId" asp-items="Model.OwnerOptions" class="form-select">
                    <option value="">No portal owner</option>
                </select>
            </div>
        }
    </div>
    <div class="mt-3 d-flex gap-2">
        <button class="btn btn-forest" type="submit">Save farm</button>
        <a class="btn btn-light" asp-action="Index">Cancel</a>
    </div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
