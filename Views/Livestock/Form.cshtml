@model LivestockFormViewModel
@{
    ViewData["Title"] = Model.Id == 0 ? "Add livestock" : "Edit livestock";
}
<div class="page-head"><div><h1>@ViewData["Title"]</h1><p>Leave Animal ID blank and the portal will assign one.</p></div></div>
<form asp-action="@(Model.Id == 0 ? "Create" : "Edit")" method="post" class="panel">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="hidden" asp-for="Id" />
    <div class="row g-3">
        <div class="col-md-4"><label asp-for="AnimalCode" class="form-label"></label><input asp-for="AnimalCode" class="form-control" /><span asp-validation-for="AnimalCode" class="text-danger small"></span></div>
        <div class="col-md-4"><label asp-for="AnimalName" class="form-label"></label><input asp-for="AnimalName" class="form-control" /><span asp-validation-for="AnimalName" class="text-danger small"></span></div>
        <div class="col-md-4">
            <label asp-for="Species" class="form-label"></label>
            <select asp-for="Species" class="form-select"><option value="">Choose</option>@foreach (var species in SpeciesList.All) { <option>@species</option> }</select>
            <span asp-validation-for="Species" class="text-danger small"></span>
        </div>
        <div class="col-md-4"><label asp-for="Breed" class="form-label"></label><input asp-for="Breed" class="form-control" /><span asp-validation-for="Breed" class="text-danger small"></span></div>
        <div class="col-md-4">
            <label asp-for="Gender" class="form-label"></label>
            <select asp-for="Gender" class="form-select"><option value="">Choose</option>@foreach (var gender in Genders.All) { <option>@gender</option> }</select>
            <span asp-validation-for="Gender" class="text-danger small"></span>
        </div>
        <div class="col-md-4"><label asp-for="DateOfBirth" class="form-label"></label><input asp-for="DateOfBirth" class="form-control" type="date" /><span asp-validation-for="DateOfBirth" class="text-danger small"></span></div>
        <div class="col-md-3"><label asp-for="Weight" class="form-label"></label><input asp-for="Weight" class="form-control" /><span asp-validation-for="Weight" class="text-danger small"></span></div>
        <div class="col-md-3">
            <label asp-for="HealthStatus" class="form-label"></label>
            <select asp-for="HealthStatus" class="form-select">@foreach (var status in HealthStatuses.All) { <option>@status</option> }</select>
        </div>
        <div class="col-md-3">
            <label asp-for="FarmId" class="form-label"></label>
            <select asp-for="FarmId" class="form-select">
                <option value="">Choose</option>
                @foreach (var farm in Model.Farms) { <option value="@farm.Id">@farm.Name</option> }
            </select>
            <span asp-validation-for="FarmId" class="text-danger small"></span>
        </div>
        <div class="col-md-3"><label asp-for="RegistrationDate" class="form-label"></label><input asp-for="RegistrationDate" class="form-control" type="date" /></div>
    </div>
    <div class="mt-3 d-flex gap-2">
        <button class="btn btn-forest" type="submit">Save livestock</button>
        <a class="btn btn-light" asp-action="Index">Cancel</a>
    </div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
