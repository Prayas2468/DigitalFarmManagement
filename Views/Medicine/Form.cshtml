@model MedicineFormViewModel
@{
    ViewData["Title"] = Model.Id == 0 ? "Add medicine batch" : "Edit medicine batch";
}
<div class="page-head">
    <div>
        <h1>@ViewData["Title"]</h1>
        <p>If the medicine name and active ingredient already exist, this batch is added to that medicine. Recording a treatment later deducts quantity from the chosen batch.</p>
    </div>
</div>
<form asp-action="@(Model.Id == 0 ? "Create" : "Edit")" method="post" class="panel">
    <div asp-validation-summary="All" class="text-danger mb-3"></div>
    <input type="hidden" asp-for="Id" />
    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="MedicineName" class="form-label"></label>
            <input asp-for="MedicineName" class="form-control" />
            <span asp-validation-for="MedicineName" class="text-danger small"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="ActiveIngredient" class="form-label"></label>
            <input asp-for="ActiveIngredient" class="form-control" />
            <span asp-validation-for="ActiveIngredient" class="text-danger small"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="Category" class="form-label"></label>
            <select asp-for="Category" class="form-select">
                <option value="">Choose</option>
                @foreach (var category in MedicineCategories.All) { <option value="@category">@category</option> }
            </select>
            <span asp-validation-for="Category" class="text-danger small"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="Manufacturer" class="form-label"></label>
            <input asp-for="Manufacturer" class="form-control" />
            <span asp-validation-for="Manufacturer" class="text-danger small"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="WithdrawalPeriodDays" class="form-label"></label>
            <input asp-for="WithdrawalPeriodDays" class="form-control" />
            <span asp-validation-for="WithdrawalPeriodDays" class="text-danger small"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="BatchNumber" class="form-label"></label>
            <input asp-for="BatchNumber" class="form-control" />
            <span asp-validation-for="BatchNumber" class="text-danger small"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="AvailableQuantity" class="form-label"></label>
            <input asp-for="AvailableQuantity" class="form-control" />
            <span asp-validation-for="AvailableQuantity" class="text-danger small"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="Unit" class="form-label"></label>
            <select asp-for="Unit" class="form-select">
                @foreach (var unit in DoseUnits.All) { <option value="@unit">@unit</option> }
            </select>
            <span asp-validation-for="Unit" class="text-danger small"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="PurchaseDate" class="form-label"></label>
            <input asp-for="PurchaseDate" class="form-control" type="date" />
            <span asp-validation-for="PurchaseDate" class="text-danger small"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="ExpiryDate" class="form-label"></label>
            <input asp-for="ExpiryDate" class="form-control" type="date" />
            <span asp-validation-for="ExpiryDate" class="text-danger small"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="LowStockThreshold" class="form-label"></label>
            <input asp-for="LowStockThreshold" class="form-control" />
            <span asp-validation-for="LowStockThreshold" class="text-danger small"></span>
        </div>
    </div>
    <div class="mt-3 d-flex gap-2">
        <button class="btn btn-forest" type="submit">Save batch</button>
        <a class="btn btn-light" asp-action="Index">Cancel</a>
    </div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
