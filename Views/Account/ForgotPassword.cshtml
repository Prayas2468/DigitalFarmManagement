@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot password";
    Layout = "_AuthLayout";
}
<div class="auth-panel" style="min-height:100vh;">
    <div class="auth-card">
        <h2>Reset your password</h2>
        <p class="text-muted">This classroom project does not send email. If the account exists, the reset form opens on the next screen.</p>
        <partial name="_Alerts" />
        <form asp-action="ForgotPassword" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
            <div class="mb-3"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" /><span asp-validation-for="Email" class="text-danger small"></span></div>
            <button class="btn btn-forest w-100" type="submit">Continue</button>
        </form>
        <p class="mt-3 mb-0 small"><a asp-action="Login">Back to sign in</a></p>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
